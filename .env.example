# Copiez ce fichier en `.env` puis adaptez les valeurs.
# Le fichier .env contient des secrets : il ne doit JAMAIS être versionné (il est dans .gitignore).

# --- Django ---
DEBUG=True
# Générez une clé avec :
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Intelligence artificielle (toutes ces options sont gratuites) ---
# demo   : aucune IA, réponses factices
# ollama : IA locale (installer https://ollama.com puis `ollama pull qwen2.5:3b`)
# groq   : API gratuite, créer une clé sur https://console.groq.com
AI_PROVIDER=ollama
# Laisser vide pour utiliser le modèle et l'URL par défaut du fournisseur.
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=90

# --- Données de démonstration (python manage.py seed_demo) ---
# Mot de passe de TEST commun aux 5 comptes agents fictifs. Ne pas réutiliser ailleurs.
DEMO_PASSWORD=Demo-Nantes-2026!
